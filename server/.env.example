PORT=8000

# MongoDB — replace with your Atlas URI or local connection string
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/taskpilot
# Local:  mongodb://localhost:27017/taskpilot
MONGODB_URI=your_mongodb_connection_string_here

# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development
